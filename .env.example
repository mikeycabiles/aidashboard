# =============================================================================
# AI-Led MarketingOS — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# ----- Telegram -----
TELEGRAM_BOT_TOKEN=your_bot_token_here
ALLOWED_CHAT_IDS=your_chat_id_here              # comma-separated for multiple

# ----- Security -----
SESSION_PIN=your_4_to_6_digit_pin_here

# ----- Gemini (Memory Washing Machine + Task Classifier) -----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_WASHER_MODEL=gemini-1.5-flash
GEMINI_CLASSIFIER_MODEL=gemini-2.0-flash-lite

# ----- Anthropic Agent SDK -----
# Only used for the Agent SDK bridge (spawning Claude Code sessions).
# Primary execution leverages Mikey's existing Claude Code subscription.
ANTHROPIC_API_KEY=your_anthropic_key_here

# ----- Database -----
SQLITE_DB_PATH=./data/marketing-os.db

# ----- Obsidian -----
# WSL path example: /mnt/c/Users/Mikey/ObsidianVault
OBSIDIAN_VAULT_PATH=/mnt/c/Users/Mikey/ObsidianVault

# ----- Dashboard -----
DASHBOARD_PORT=3000
DASHBOARD_SECRET=random_secret_for_websocket_auth

# ----- Cloudflare Tunnel (optional at setup time) -----
CF_TUNNEL_NAME=ai-led-marketing-os

# ----- Optional: Nano Banana API (thumbnail generation for Content agent) -----
NANO_BANANA_API_KEY=your_key_here
